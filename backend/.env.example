# ============================================================
# 工业 AI SOP 后端配置
# 复制为 backend/.env 后按需修改；所有变量均带 SOP_ 前缀。
# 未写绝对路径，默认值都相对于项目目录计算。
# ============================================================

SOP_ENV=dev
SOP_HOST=127.0.0.1
SOP_PORT=8000
SOP_LOG_LEVEL=INFO

# 允许的前端来源，多个用英文逗号分隔
SOP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 工位信息
SOP_STATION_ID=WS-01
SOP_STATION_NAME=装配工位 A

# 推理模式：auto | yolo | mock
#   auto: 找到权重且 ultralytics 可用时启用 YOLO，否则明确降级为模拟检测器
#   yolo: 强制真实 YOLO（失败时状态为 ERROR，不会静默降级）
#   mock: 强制模拟检测器（仅用于联调，界面会显示 SIMULATION 标识）
SOP_INFERENCE_MODE=auto

# 模型权重路径（相对项目根目录或绝对路径均可）
SOP_MODEL_PATH=models/weights/gesture_yolo.pt
SOP_MODEL_CLASS_MAP=models/class_map.json
SOP_MODEL_DEVICE=cpu
SOP_MODEL_CONF=0.45
SOP_MODEL_IOU=0.50
SOP_MODEL_IMGSZ=640

# 摄像头：auto | device | synthetic | off
#   auto: 优先打开本机摄像头，失败时切换到带水印的模拟画面
SOP_CAMERA_MODE=auto
SOP_CAMERA_INDEX=0
SOP_CAMERA_WIDTH=1280
SOP_CAMERA_HEIGHT=720
SOP_CAMERA_FPS=12

# 推理与检测稳定性
SOP_INFERENCE_FPS=5
SOP_DETECTION_MIN_CONFIDENCE=0.50
SOP_DETECTION_STABLE_FRAMES=3
SOP_DETECTION_RESET_MS=500

# 模拟检测器场景：clean（正常流程）| faulty（含错序/重复）
SOP_MOCK_SCENARIO=clean
SOP_MOCK_STEP_DWELL_SECONDS=2.0
SOP_MOCK_REST_SECONDS=1.0

# SOP 规则策略
SOP_FAIL_ON_SEQUENCE_ERROR=true
SOP_FAIL_ON_TIMEOUT=true
SOP_SESSION_MAX_SECONDS=300
# 检测到第一个有效动作时自动开始会话
SOP_AUTO_START_SESSION=true

# 实时推送
SOP_WS_TELEMETRY_INTERVAL_MS=300

# 是否启动采集/推理后台任务（测试时可设为 false）
SOP_RUNTIME_ENABLED=true

# 数据库（默认 data/sop.db）
# SOP_DATABASE_PATH=data/sop.db
